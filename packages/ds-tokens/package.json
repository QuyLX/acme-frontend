{
  "name": "@platform/ds-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design tokens (DTCG) → CSS variables, Tailwind v4 theme and typed constants (FE §5.1 Foundation tier).",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    }
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "style-dictionary": "5.8.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:lib"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
