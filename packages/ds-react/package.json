{
  "name": "@platform/ds-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design System React components — Foundation tier core controls on React Aria Components (FE §5).",
  "exports": {
    ".": "./src/index.ts",
    "./agent-manifest.json": "./dist/agent-manifest.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-manifest.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:browser": "vitest run --config vitest.browser.config.ts .browser.test.",
    "test:visual": "vitest run --config vitest.browser.config.ts .visual.test.",
    "ds": "node scripts/ds.mjs"
  },
  "dependencies": {
    "@platform/ds-icons": "workspace:*",
    "react-aria-components": "1.22.1"
  },
  "peerDependencies": {
    "react": ">=19.3",
    "react-dom": ">=19.3"
  },
  "devDependencies": {
    "@platform/ds-tokens": "workspace:*",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:lib"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "build-storybook": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/storybook-static"
        ],
        "cache": true
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
